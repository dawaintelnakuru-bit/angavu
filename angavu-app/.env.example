# ==============================================================
# Angavu Environment Configuration
# ==============================================================

# Server Port (default: 5000)
PORT=5000
NODE_ENV=development

# Clerk Authentication (Server & Client)
CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key
SESSION_SECRET=your_session_secret_for_signing
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key

# SQLite Database File Path (Optional, defaults to ./angavu.db)
DATABASE_PATH=./angavu.db

# Google Sheets Service Account (Server-side only, never exposed to client)
# Option A: Email + Private Key (Recommended)
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Option B: Full JSON Key (Raw JSON string or base64)
# GOOGLE_SERVICE_ACCOUNT_KEY='{"type": "service_account", ...}'

# Option C: Path to credentials file
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/credentials.json
